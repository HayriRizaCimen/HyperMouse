<ui:FluentWindow x:Class="HyperMouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:controls="clr-namespace:HyperMouse.Controls"
        mc:Ignorable="d"
        Title="HyperMouse"
        Icon="pack://application:,,,/Assets/HyperMouse.ico"
        Height="680" Width="1020"
        MinHeight="590" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Acrylic">

    <ui:FluentWindow.Resources>
        <!-- Sidebar navigation item (Dark Glassmorphism + Neon Cyan active glow) -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" Padding="12,11" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left" Margin="-12,0,0,0"
                                        Background="#00E5FF" Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="8" ShadowDepth="0" Opacity="0.85" />
                                    </Border.Effect>
                                </Border>
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A00E5FF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9000E5FF" />
                                <Setter TargetName="Bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.45" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider: filled (accent) on the left of the thumb -->
        <Style x:Key="SliderTrackPart" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentSlider" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderTrackPart}"
                                                  Background="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackPart}"
                                                  Background="{DynamicResource ControlStrongFillColorDefaultBrush}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="20" Height="20">
                                                    <Ellipse Fill="{DynamicResource ControlSolidFillColorDefaultBrush}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                                                    <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Dot" Property="Width" Value="14" />
                                                        <Setter TargetName="Dot" Property="Height" Value="14" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Dot" Property="Width" Value="10" />
                                                        <Setter TargetName="Dot" Property="Height" Value="10" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Deep dark navy/purple backdrop + ambient radial glows (themed dynamically for Dark/Light) -->
        <Grid x:Name="AmbientBackdrop" Grid.RowSpan="2" IsHitTestVisible="False">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#EA0B0D14" Offset="0.0" />
                    <GradientStop Color="#EA101424" Offset="0.5" />
                    <GradientStop Color="#EA15192B" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <!-- Top-left neon purple ambient glow -->
            <Ellipse Width="580" Height="580" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-180,-200,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#389D4EDD" Offset="0.0" />
                        <GradientStop Color="#129D4EDD" Offset="0.45" />
                        <GradientStop Color="#009D4EDD" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Bottom-right neon cyan ambient glow -->
            <Ellipse Width="640" Height="640" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-200,-220">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2E00E5FF" Offset="0.0" />
                        <GradientStop Color="#0E00E5FF" Offset="0.45" />
                        <GradientStop Color="#0000E5FF" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- Center subtle indigo glow -->
            <Ellipse Width="520" Height="420" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="120,-120,0,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#1F5E60CE" Offset="0.0" />
                        <GradientStop Color="#005E60CE" Offset="1.0" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <ui:TitleBar Grid.Row="0" Title="HyperMouse" ShowMaximize="True" ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/HyperMouse.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <Border CornerRadius="8" BorderThickness="1" BorderBrush="#9D4EDD" Background="#1C9D4EDD"
                        Margin="0,0,8,0" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border.Effect>
                        <DropShadowEffect Color="#9D4EDD" BlurRadius="12" ShadowDepth="0" Opacity="0.55" />
                    </Border.Effect>
                    <ui:Button x:Name="BtnExitApp" Appearance="Transparent" Padding="12,5" BorderThickness="0"
                               ToolTip="HyperMouse'u tamamen kapatır (tepsiye küçültmez)" Click="BtnExitApp_Click"
                               WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="KillSwitchIcon" Symbol="Power20" FontSize="14" Margin="0,0,6,0" Foreground="#E0AAFF" />
                            <TextBlock x:Name="KillSwitchText" Text="Kill Switch" FontSize="12" FontWeight="SemiBold" Foreground="#F3D9FF" />
                        </StackPanel>
                    </ui:Button>
                </Border>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid x:Name="MainContentHost" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR (232px Glass Card) ================= -->
            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" Margin="16,6,8,20" Padding="14,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="6,2,0,24">
                        <Image Source="pack://application:,,,/Assets/HyperMouse.ico" Width="38" Height="38"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="HyperMouse" FontSize="16" FontWeight="Bold" />
                            <TextBlock x:Name="TxtAppSubtitle" Text="Mouse remapper" Style="{StaticResource Caption}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavRules" Style="{StaticResource NavItem}" IsChecked="True" Checked="Nav_Checked" Tag="Rules">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Apps24" FontSize="18" Margin="0,0,12,0" />
                                <TextBlock x:Name="TxtNavKeyMap" Text="Tuş Haritası" FontSize="14" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavLive" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Live">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Pulse24" FontSize="18" Margin="0,0,12,0" />
                                <TextBlock x:Name="TxtNavLive" Text="Canlı Test" FontSize="14" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Checked="Nav_Checked" Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,12,0" />
                                <TextBlock x:Name="TxtNavSettings" Text="Ayarlar" FontSize="14" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <!-- Engine status + exit -->
                    <StackPanel Grid.Row="2">
                        <Border CornerRadius="12" Padding="12,12" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#46C15E" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock x:Name="StatusBadgeText" Text="Motor aktif" FontWeight="SemiBold" FontSize="13" />
                                    </StackPanel>
                                    <TextBlock x:Name="StatusSubText" Text="Hook aktif" Style="{StaticResource Caption}" FontSize="11" Margin="16,2,0,0" />
                                    <TextBlock x:Name="TxtToggleShortcuts" Text="Ctrl+Alt+Shift+M veya Fare Tuşu" Style="{StaticResource Caption}" FontSize="10" Margin="16,2,0,0" Opacity="0.7" />
                                </StackPanel>
                                <ui:ToggleSwitch x:Name="EngineToggle" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 Checked="EngineToggle_Checked" Unchecked="EngineToggle_Unchecked" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= CONTENT ================= -->
            <Grid Grid.Column="1" Margin="12,6,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Detected mouse hero -->
                <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" Padding="20,16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <ui:SymbolIcon Symbol="UsbStick24" x:Name="MouseConnIcon" FontSize="26"
                                           Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeroTitle" Text="ALGILANAN FARE" Style="{StaticResource Caption}" FontSize="10" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtMouseModel" Text="Fare aranıyor…" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <ui:TextBox x:Name="TxtMouseAlias" Visibility="Collapsed" MinWidth="240" FontSize="15" PlaceholderText="Örn: Philips SPK7547"
                                            KeyDown="TxtMouseAlias_KeyDown" />
                                <ui:Button x:Name="BtnRenameMouse" Appearance="Transparent" Padding="6" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Icon="{ui:SymbolIcon Edit16}" ToolTip="Fareye ad ver" Click="BtnRenameMouse_Click" />
                            </StackPanel>
                            <TextBlock x:Name="TxtMouseDetails" Text="" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="DpiStatusChip" CornerRadius="12" Padding="10,4" Margin="0,0,10,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Gauge24" FontSize="14" Margin="0,0,6,0" />
                                    <TextBlock x:Name="TxtDpiStatus" Text="DPI tuşu öğretilmedi" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="12" Padding="10,4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <TextBlock x:Name="TxtMouseCount" Text="0 fare" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ================= PAGE: RULES ================= -->
                <Grid Grid.Row="1" x:Name="PageRules">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtPageRulesTitle" Text="Tuş Haritası" Style="{StaticResource PageTitle}" />
                                <Border CornerRadius="10" Padding="8,2" Margin="10,4,0,0" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <TextBlock x:Name="RuleCountText" Text="0 kural" FontSize="12" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="TxtPageRulesSubtitle" Text="Her tuş ve ritim için bir eylem belirleyin."
                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Profile selector card -->
                            <Border Style="{StaticResource GlassCardStyle}" Padding="6,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Folder24" FontSize="16" Margin="6,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <ComboBox x:Name="CmbProfileSelect" MinWidth="130" MaxWidth="190" SelectionChanged="CmbProfileSelect_SelectionChanged" VerticalAlignment="Center" />
                                    <ui:Button x:Name="BtnNewProfile" Appearance="Transparent" Padding="6,5" Margin="4,0,2,0" ToolTip="Yeni Profil" Click="BtnNewProfile_Click">
                                        <ui:SymbolIcon Symbol="Add16" FontSize="14" />
                                    </ui:Button>
                                    <ui:Button x:Name="BtnRenameProfile" Appearance="Transparent" Padding="6,5" Margin="0,0,2,0" ToolTip="Profili Yeniden Adlandır" Click="BtnRenameProfile_Click">
                                        <ui:SymbolIcon Symbol="Edit16" FontSize="14" />
                                    </ui:Button>
                                    <ui:Button x:Name="BtnDeleteProfile" Appearance="Transparent" Padding="6,5" Margin="0,0,2,0" ToolTip="Profili Sil" Click="BtnDeleteProfile_Click" Foreground="#E5534B">
                                        <ui:SymbolIcon Symbol="Delete16" FontSize="14" Foreground="#E5534B" />
                                    </ui:Button>
                                </StackPanel>
                            </Border>

                            <ui:Button x:Name="BtnToggleAddRule" Appearance="Primary"
                                       Click="BtnToggleAddRule_Click" Icon="{ui:SymbolIcon Add24}" Content="Yeni Kural" Padding="16,9" CornerRadius="10" />
                        </StackPanel>
                    </Grid>

                    <!-- DPI learn strip -->
                    <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="16,12" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="40" Height="40" VerticalAlignment="Center">
                                <Border x:Name="LearnIcon" CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <ui:SymbolIcon Symbol="Gauge24" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                </Border>
                                <Grid x:Name="LearnCountdown" Visibility="Collapsed">
                                    <ui:ProgressRing x:Name="LearnRing" Width="40" Height="40" IsIndeterminate="False" Progress="100" />
                                    <TextBlock x:Name="LearnCountdownText" Text="3" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtDpiTitle" Text="DPI tuşu" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtLearnStatus" TextWrapping="Wrap" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="'Öğren'e basıp DPI tuşunu tıklayın." />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button x:Name="BtnForgetDpi" Content="Unut" Margin="0,0,8,0" Padding="14,8" CornerRadius="10" Click="BtnForgetDpi_Click" Visibility="Collapsed" />
                                <ui:Button x:Name="BtnLearnDpi" Appearance="Primary" Content="Öğren" Padding="16,8" CornerRadius="10" Icon="{ui:SymbolIcon Record24}" Click="BtnLearnDpi_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Editor moved to frosted-glass modal overlay (RuleModalOverlay) below -->

                    <!-- Empty state -->
                    <StackPanel Grid.Row="2" x:Name="EmptyRulesPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="CursorClick24" FontSize="48" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TxtEmptyRulesTitle" Text="Henüz kural yok" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock x:Name="TxtEmptyRulesSubtitle" Text="'Yeni Kural' ile başlayın." Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ListBox Grid.Row="2" x:Name="RulesListBox"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="False"
                             PreviewMouseLeftButtonDown="RulesListBox_PreviewMouseLeftButtonDown"
                             PreviewMouseMove="RulesListBox_PreviewMouseMove"
                             PreviewMouseLeftButtonUp="RulesListBox_PreviewMouseLeftButtonUp"
                             LostMouseCapture="RulesListBox_LostMouseCapture">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCardStyle}" Margin="6" Padding="16,14" Cursor="SizeAll" ToolTip="Sıralamak için tutup sürükleyin">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <ui:SymbolIcon Grid.Column="0" Symbol="ReOrderDotsVertical24" FontSize="16" Margin="0,0,10,0"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />

                                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="10" Background="{Binding AccentSoft}" VerticalAlignment="Center">
                                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" Foreground="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="2" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ButtonName}" FontWeight="SemiBold" FontSize="14" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Border CornerRadius="9" Padding="8,1" Background="{Binding AccentSoft}">
                                                    <TextBlock Text="{Binding CadenceDescription}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Accent}" />
                                                </Border>
                                                <ui:SymbolIcon Symbol="ArrowRight16" FontSize="12" Margin="8,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ActionDisplay}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

                                        <ui:Button Grid.Column="3" Appearance="Secondary" Width="44" Height="44" Padding="0" CornerRadius="10"
                                                   Tag="{Binding}" Click="BtnEditRule_Click" Cursor="Hand" ToolTip="Düzenle" Margin="0,0,8,0">
                                            <ui:SymbolIcon Symbol="Edit24" FontSize="20" />
                                        </ui:Button>
                                        <ui:Button Grid.Column="4" Appearance="Secondary" Width="44" Height="44" Padding="0" CornerRadius="10"
                                                   Tag="{Binding}" Click="BtnDeleteRule_Click" Cursor="Hand" ToolTip="Sil" Foreground="#E5534B">
                                            <ui:SymbolIcon Symbol="Delete24" FontSize="20" Foreground="#E5534B" />
                                        </ui:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- ================= PAGE: LIVE ================= -->
                <Grid Grid.Row="1" x:Name="PageLive" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">

                        <Border Style="{StaticResource GlassCardStyle}" Padding="22" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel>
                                        <TextBlock x:Name="TxtLiveTitle" Text="Canlı Test" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="TxtLiveSubtitle" Text="Basılan tuşlar anlık olarak gösterilir." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <ToggleButton x:Name="BtnToggleLog" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,5"
                                                  Checked="BtnToggleLog_Changed" Unchecked="BtnToggleLog_Changed">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="TextBulletListLtr20" FontSize="16" Margin="0,0,6,0" />
                                            <TextBlock x:Name="TxtLiveBtnLog" Text="Olay kaydı" />
                                        </StackPanel>
                                    </ToggleButton>
                                </Grid>

                                <!-- Realistic 3D Mouse Visual -->
                                <controls:Mouse3DVisual x:Name="MouseVisual3D" Grid.Row="1" Margin="0,8" MinHeight="220" />

                                <Border Grid.Row="2" CornerRadius="10" Padding="14,12" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock x:Name="TxtLiveLastEventTitle" Text="Son olay" Style="{StaticResource Caption}" FontSize="11" />
                                            <TextBlock x:Name="TxtDetectedEvent" Text="Farenizi test edin…" FontSize="16" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtLiveTriggeredCadenceTitle" Text="Tetiklenen ritim" Style="{StaticResource Caption}" FontSize="11" HorizontalAlignment="Right" />
                                            <TextBlock x:Name="TxtDetectedCadence" Text="—" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>

                    <Border Grid.Column="1" x:Name="LogCard" Style="{StaticResource GlassCardStyle}" Visibility="Collapsed" Width="380" Margin="16,0,0,0" Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLiveLogTitle" Text="Olay kaydı" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkVerboseHid" Content="Ayrıntılı" ToolTip="Hook, RawInput ve HID ayrıntılarını da göster" Margin="0,0,8,0" Checked="ChkVerboseHid_Changed" Unchecked="ChkVerboseHid_Changed" />
                                    <ui:Button x:Name="BtnClearLog" Appearance="Transparent" Icon="{ui:SymbolIcon Delete20}" ToolTip="Kaydı temizle" Click="BtnClearLog_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" CornerRadius="8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <ListBox x:Name="LiveEventListBox" Background="Transparent" BorderThickness="0"
                                         FontSize="12" Padding="4" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ================= PAGE: SETTINGS ================= -->
                <ScrollViewer Grid.Row="1" x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="740" HorizontalAlignment="Left">
                        <TextBlock x:Name="TxtSettingsTitle" Text="Ayarlar" Style="{StaticResource PageTitle}" Margin="0,0,0,16" />

                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="22">
                            <StackPanel>
                                <TextBlock x:Name="TxtSettingsCadenceTitle" Text="Ritim hassasiyeti" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtSettingsCadenceSubtitle" Text="Çift tık ve uzun basma süreleri." Style="{StaticResource Caption}" Margin="0,2,0,16" />
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtSettingsDoubleClick" Text="Çift tıklama penceresi" FontWeight="Medium" />
                                    <TextBlock x:Name="TxtDoubleClickVal" Text="280 ms" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                                <Slider x:Name="SliderDoubleClick" Style="{StaticResource AccentSlider}" Minimum="150" Maximum="500" Value="280" ValueChanged="SliderDoubleClick_ValueChanged" Margin="0,0,0,16" />
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtSettingsLongPress" Text="Uzun basma eşiği" FontWeight="Medium" />
                                    <TextBlock x:Name="TxtLongPressVal" Text="320 ms" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                </Grid>
                                <Slider x:Name="SliderLongPress" Style="{StaticResource AccentSlider}" Minimum="200" Maximum="800" Value="320" ValueChanged="SliderLongPress_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <!-- Fare Tuşuyla Devre Dışı Bırak / Aktif Et Card -->
                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="22">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TxtSettingsQuickDisableTitle" Grid.Column="0" Text="Fare Tuşu ile Duraklat / Aktif Et" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ui:ToggleSwitch x:Name="ToggleQuickDisable" Grid.Column="1" VerticalAlignment="Center"
                                                     IsChecked="True" Checked="ToggleQuickDisable_Changed" Unchecked="ToggleQuickDisable_Changed" />
                                </Grid>
                                <TextBlock x:Name="TxtSettingsQuickDisableSubtitle" Text="Seçilen tuşa basılı tutarak veya tıklayarak motoru duraklatın/açın."
                                           Style="{StaticResource Caption}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                <Grid x:Name="QuickDisableOptionsPanel" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="TxtSettingsTriggerButton" Text="Tetikleyici Tuş" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="CmbQuickDisableButton" SelectionChanged="QuickDisableSettings_Changed">
                                            <ComboBoxItem Content="Yan Tuş 2 (İleri)" Tag="XButton2" />
                                            <ComboBoxItem Content="Yan Tuş 1 (Geri)" Tag="XButton1" />
                                            <ComboBoxItem Content="Orta Tuş (Tekerlek tıkı)" Tag="Middle" />
                                            <ComboBoxItem Content="DPI Tuşu (öğretilmiş)" Tag="DpiButton" />
                                            <ComboBoxItem Content="Sağ Tuş" Tag="Right" />
                                            <ComboBoxItem Content="Sol Tuş" Tag="Left" />
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="TxtSettingsTriggerCadence" Text="Tetikleme Yöntemi" Style="{StaticResource FieldLabel}" />
                                        <ComboBox x:Name="CmbQuickDisableCadence" SelectionChanged="QuickDisableSettings_Changed">
                                            <ComboBoxItem Content="Uzun Basma (Hold — 1 sn)" Tag="Hold" />
                                            <ComboBoxItem Content="Üçlü Tık (3 Kez Tıkla)" Tag="TripleClick" />
                                            <ComboBoxItem Content="Dörtlü Tık (4 Kez Tıkla)" Tag="QuadClick" />
                                            <ComboBoxItem Content="Çift Tık (2 Kez Tıkla)" Tag="DoubleClick" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="22">
                            <StackPanel>
                                <TextBlock x:Name="TxtSettingsConnectedMiceTitle" Text="Bağlı fareler" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtSettingsConnectedMiceSubtitle" Text="Algılanan fare aygıtları." Style="{StaticResource Caption}" Margin="0,2,0,12" />
                                <ItemsControl x:Name="MiceList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="12,8" Margin="0,0,0,6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Style="{StaticResource Caption}">
                                                            <Run Text="{Binding VidPid, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Connection, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,0,16" Padding="22">
                            <StackPanel>
                                <TextBlock x:Name="TxtSettingsAppTitle" Text="Uygulama" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />

                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtSettingsLanguageTitle" Text="Dil" FontWeight="Medium" />
                                        <TextBlock x:Name="TxtSettingsLanguageSubtitle" Text="Uygulama arayüz dili." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ComboBox x:Name="CmbLanguage" Width="160" HorizontalAlignment="Right" SelectionChanged="CmbLanguage_SelectionChanged">
                                        <ComboBoxItem Content="Türkçe" Tag="tr" />
                                        <ComboBoxItem Content="English" Tag="en" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtSettingsThemeTitle" Text="Tema" FontWeight="Medium" />
                                        <TextBlock x:Name="TxtSettingsThemeSubtitle" Text="Sistem, koyu veya açık." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ComboBox x:Name="CmbTheme" Width="160" HorizontalAlignment="Right" SelectionChanged="CmbTheme_SelectionChanged">
                                        <ComboBoxItem Content="Sistem" Tag="System" />
                                        <ComboBoxItem Content="Koyu" Tag="Dark" />
                                        <ComboBoxItem Content="Açık" Tag="Light" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtSettingsAutostartTitle" Text="Windows ile başlat" FontWeight="Medium" />
                                        <TextBlock x:Name="TxtSettingsAutostartSubtitle" Text="Windows açıldığında arka planda başlar." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="ToggleAutostart" HorizontalAlignment="Right" Checked="ToggleAutostart_Changed" Unchecked="ToggleAutostart_Changed" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtSettingsTrayTitle" Text="Kapatınca tepsiye küçült" FontWeight="Medium" />
                                        <TextBlock x:Name="TxtSettingsTraySubtitle" Text="Pencere kapatıldığında sistem tepsisine küçülür." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <ui:ToggleSwitch x:Name="ToggleTray" HorizontalAlignment="Right" Checked="ToggleTray_Changed" Unchecked="ToggleTray_Changed" />
                                </Grid>

                                <Grid>
                                    <StackPanel>
                                        <TextBlock x:Name="TxtSettingsHotkeyTitle" Text="Acil durdurma kısayolu" FontWeight="Medium" />
                                        <TextBlock x:Name="TxtHotkeyStatus" Text="Motoru genel kısayolla duraklatır/açar." Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="6" Padding="10,4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="Ctrl + Alt + Shift + M" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource GlassCardStyle}" Padding="22">
                            <StackPanel>
                                <TextBlock x:Name="TxtSettingsProfileTitle" Text="Profil Yönetimi" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtSettingsProfileSubtitle" Text="Profil ve tuş haritalarını yönetin." Style="{StaticResource Caption}" Margin="0,2,0,14" />
                                <WrapPanel>
                                    <ui:Button Click="BtnExport_Click" Margin="0,0,8,8" Padding="14,9" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M4,15 L4,18 C4,19.1 4.9,20 6,20 L18,20 C19.1,20 20,19.1 20,18 L20,15 M12,4 L12,15 M7.5,8.5 L12,4 L16.5,8.5"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="TxtBtnExport" Text="Dışa aktar" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button Click="BtnImport_Click" Margin="0,0,8,8" Padding="14,9" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M4,15 L4,18 C4,19.1 4.9,20 6,20 L18,20 C19.1,20 20,19.1 20,18 L20,15 M12,4 L12,15 M7.5,10.5 L12,15 L16.5,10.5"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="TxtBtnImport" Text="İçe aktar" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                    <ui:Button x:Name="BtnOpenConfigFolder" Content="Klasörü aç" Icon="{ui:SymbolIcon FolderOpen24}" Click="BtnOpenConfigFolder_Click" Margin="0,0,8,8" Padding="14,9" CornerRadius="10" />
                                    <ui:Button x:Name="BtnResetDefaults" Appearance="Danger" Click="BtnResetDefaults_Click" Margin="0,0,0,8" Padding="14,9" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal">
                                            <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M4,12 A8,8 0 1,1 6.3,17.7 M4,5.5 L4,12 L10.5,12"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ui:Button}}"
                                                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock x:Name="TxtBtnResetDefaults" Text="Varsayılana sıfırla" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ui:Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================= FROSTED MODAL POPUP: ADD / EDIT RULE ================= -->
        <Grid x:Name="RuleModalOverlay" Grid.Row="1" Visibility="Collapsed" Background="#7A060812"
              MouseLeftButtonDown="RuleModalBackdrop_MouseLeftButtonDown">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="590"
                  MouseLeftButtonDown="AddRuleCard_MouseLeftButtonDown">
                <!-- Shadow on sibling layer so ComboBoxes don't jitter inside an Effect bitmap pass -->
                <Border CornerRadius="16" Background="#22000000" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.65" />
                    </Border.Effect>
                </Border>
                <Border x:Name="AddRuleCard" Style="{StaticResource GlassCardStyle}" Padding="28">
                    <Border.Resources>
                        <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
                    </Border.Resources>
                    <StackPanel>
                        <Grid Margin="0,0,0,20">
                            <TextBlock x:Name="AddRuleTitle" Text="Yeni Tuş Eşlemesi" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <ui:Button Appearance="Transparent" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Padding="8" Click="BtnCancelAddRule_Click" ToolTip="Kapat">
                                <ui:SymbolIcon Symbol="Dismiss20" FontSize="16" />
                            </ui:Button>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel x:Name="ModalField1" Grid.Row="0" Grid.Column="0">
                                <TextBlock x:Name="LblModalStep1" Text="1 · Fare tuşu" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="CmbTargetButton" SelectedIndex="0" SelectionChanged="Editor_SelectionChanged">
                                    <ComboBoxItem Content="Yan Tuş 1 (Geri)" Tag="XButton1" />
                                    <ComboBoxItem Content="Yan Tuş 2 (İleri)" Tag="XButton2" />
                                    <ComboBoxItem Content="Orta Tuş (Tekerlek tıkı)" Tag="Middle" />
                                    <ComboBoxItem Content="Sağ Tuş" Tag="Right" />
                                    <ComboBoxItem Content="Sol Tuş" Tag="Left" />
                                    <ComboBoxItem Content="Tekerlek Yukarı" Tag="WheelUp" />
                                    <ComboBoxItem Content="Tekerlek Aşağı" Tag="WheelDown" />
                                    <ComboBoxItem Content="Tekerlek Sola Eğ" Tag="WheelTiltLeft" />
                                    <ComboBoxItem Content="Tekerlek Sağa Eğ" Tag="WheelTiltRight" />
                                    <ComboBoxItem Content="DPI Tuşu (öğretilmiş)" Tag="DpiButton" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="ModalField2" Grid.Row="0" Grid.Column="2">
                                <TextBlock x:Name="LblModalStep2" Text="2 · Ritim" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="CmbCadence" SelectedIndex="0" SelectionChanged="CmbCadence_SelectionChanged">
                                    <ComboBoxItem Content="Tek Tık" Tag="SingleClick" />
                                    <ComboBoxItem Content="Çift Tık" Tag="DoubleClick" />
                                    <ComboBoxItem Content="Üçlü Tık" Tag="TripleClick" />
                                    <ComboBoxItem Content="Uzun Basma" Tag="LongPress" />
                                    <ComboBoxItem Content="Bas-Çek (Press &amp; Hold)" Tag="PressAndHoldDown" />
                                    <ComboBoxItem Content="Kombinasyon (Chord)" Tag="Chord" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="ModalField3" Grid.Row="2" Grid.Column="0">
                                <TextBlock x:Name="LblModalStep3" Text="3 · Eylem türü" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="CmbActionType" SelectedIndex="0" SelectionChanged="CmbActionType_SelectionChanged">
                                    <ComboBoxItem Content="Klavye kısayolu" Tag="Hotkey" />
                                    <ComboBoxItem Content="Medya &amp; ses" Tag="Media" />
                                    <ComboBoxItem Content="Fare tuşu simülasyonu" Tag="Mouse" />
                                    <ComboBoxItem Content="Hazır metin yaz" Tag="Text" />
                                    <ComboBoxItem Content="Program / URL aç" Tag="Launch" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel x:Name="ModalField4" Grid.Row="2" Grid.Column="2">
                                <TextBlock x:Name="ActionParamLabel" Text="4 · Kısayol" Style="{StaticResource FieldLabel}" />
                                <ui:TextBox x:Name="TxtActionParam" Text="Ctrl+C" PlaceholderText="Örn: Ctrl+C, Win+D, Alt+F4" TextChanged="Editor_TextChanged" />
                                <ComboBox x:Name="CmbMediaAction" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="Editor_SelectionChanged">
                                    <ComboBoxItem Content="Sesi Aç" Tag="VolumeUp" />
                                    <ComboBoxItem Content="Sesi Kıs" Tag="VolumeDown" />
                                    <ComboBoxItem Content="Sesi Kapat / Aç" Tag="VolumeMute" />
                                    <ComboBoxItem Content="Oynat / Durdur" Tag="PlayPause" />
                                    <ComboBoxItem Content="Sonraki Parça" Tag="NextTrack" />
                                    <ComboBoxItem Content="Önceki Parça" Tag="PreviousTrack" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="ChordSecondaryPanel" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock x:Name="LblModalChordSecondary" Text="Basılıyken ikinci tuş" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="CmbChordSecondary" SelectedIndex="0" Width="320" HorizontalAlignment="Left" SelectionChanged="Editor_SelectionChanged">
                                <ComboBoxItem Content="Tekerlek Yukarı" Tag="WheelUp" />
                                <ComboBoxItem Content="Tekerlek Aşağı" Tag="WheelDown" />
                                <ComboBoxItem Content="Sol Tık" Tag="Left" />
                                <ComboBoxItem Content="Sağ Tık" Tag="Right" />
                                <ComboBoxItem Content="Orta Tık" Tag="Middle" />
                            </ComboBox>
                        </StackPanel>

                        <ui:InfoBar x:Name="ConflictInfo" Title="Çakışma" Severity="Error" IsClosable="False" IsOpen="False" Margin="0,16,0,0" />
                        <ui:InfoBar x:Name="DpiHintInfo" Title="DPI tuşu henüz öğretilmedi" Severity="Warning" IsClosable="False" IsOpen="False" Margin="0,16,0,0"
                                    Message="Önce Canlı Test sayfasından DPI tuşunu öğretin." />

                        <StackPanel x:Name="ModalFooter" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                            <ui:Button x:Name="BtnCancelAddRule" Content="İptal" Click="BtnCancelAddRule_Click" Padding="18,9" CornerRadius="10" Margin="0,0,10,0" />
                            <ui:Button x:Name="BtnSaveRule" Appearance="Primary" Content="Kaydet" Padding="20,9" CornerRadius="10" Click="BtnSaveRule_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= FROSTED MODAL POPUP: DELETE CONFIRM ================= -->
        <Grid x:Name="DeleteConfirmModalOverlay" Grid.Row="1" Visibility="Collapsed" Background="#7A060812"
              MouseLeftButtonDown="DeleteConfirmBackdrop_MouseLeftButtonDown">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="430"
                  MouseLeftButtonDown="DeleteConfirmCard_MouseLeftButtonDown">
                <Border CornerRadius="16" Background="#22000000" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.65" />
                    </Border.Effect>
                </Border>
                <Border x:Name="DeleteConfirmCard" Style="{StaticResource GlassCardStyle}" Padding="26">
                    <StackPanel>
                        <!-- Header with Warning/Trash icon and Title -->
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="#22E5534B" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="20" Foreground="#E5534B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtDeleteConfirmTitle" Text="Kuralı Sil" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtDeleteConfirmSubtitle" Text="Bu işlem geri alınamaz" Style="{StaticResource Caption}" Foreground="#E5534B" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Appearance="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Padding="6" Click="BtnCancelDelete_Click" ToolTip="Kapat">
                                <ui:SymbolIcon Symbol="Dismiss20" FontSize="15" />
                            </ui:Button>
                        </Grid>

                        <!-- Rule info preview card -->
                        <Border CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                Padding="14,12" Margin="0,0,0,18">
                            <StackPanel>
                                <TextBlock x:Name="DeleteConfirmRuleName" Text="Yan Tuş 1 · Tek Tık" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock x:Name="DeleteConfirmRuleAction" Text="Kopyala (Ctrl + C)" Style="{StaticResource Caption}" FontSize="12" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="TxtDeleteConfirmPrompt" Text="Bu kural silinecektir. Onaylıyor musunuz?" TextWrapping="Wrap" Margin="0,0,0,22" />

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button x:Name="BtnCancelDelete" Content="Vazgeç" Click="BtnCancelDelete_Click" Padding="18,9" CornerRadius="10" Margin="0,0,10,0" />
                            <ui:Button x:Name="BtnConfirmDelete" Appearance="Danger" Content="Kuralı Sil" Padding="20,9" CornerRadius="10" Click="BtnConfirmDelete_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= FROSTED MODAL POPUP: PROFILE PROMPT (NEW / RENAME) ================= -->
        <Grid x:Name="ProfilePromptModalOverlay" Grid.Row="1" Visibility="Collapsed" Background="#7A060812"
              MouseLeftButtonDown="ProfilePromptBackdrop_MouseLeftButtonDown">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="430"
                  MouseLeftButtonDown="ProfilePromptCard_MouseLeftButtonDown">
                <Border CornerRadius="16" Background="#22000000" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.65" />
                    </Border.Effect>
                </Border>
                <Border x:Name="ProfilePromptCard" Style="{StaticResource GlassCardStyle}" Padding="26">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon x:Name="ProfilePromptIcon" Symbol="Folder24" FontSize="20" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtProfilePromptTitle" Text="Yeni Profil" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtProfilePromptSubtitle" Text="Profil adı girin" Style="{StaticResource Caption}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Appearance="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Padding="6" Click="BtnCancelProfilePrompt_Click" ToolTip="Kapat">
                                <ui:SymbolIcon Symbol="Dismiss20" FontSize="15" />
                            </ui:Button>
                        </Grid>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock x:Name="TxtProfilePromptLabel" Text="Profil Adı" Style="{StaticResource FieldLabel}" />
                            <ui:TextBox x:Name="TxtProfilePromptInput" Text="" PlaceholderText="Örn: Oyun, İş, Çizim"
                                        KeyDown="TxtProfilePromptInput_KeyDown" TextChanged="TxtProfilePromptInput_TextChanged" />
                        </StackPanel>

                        <ui:InfoBar x:Name="ProfilePromptError" Title="Hata" Severity="Error" IsClosable="False" IsOpen="False" Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button x:Name="BtnProfilePromptCancel" Content="İptal" Click="BtnCancelProfilePrompt_Click" Padding="18,9" CornerRadius="10" Margin="0,0,10,0" />
                            <ui:Button x:Name="BtnProfilePromptConfirm" Appearance="Primary" Content="Kaydet" Padding="20,9" CornerRadius="10" Click="BtnConfirmProfilePrompt_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ================= FROSTED MODAL POPUP: PROFILE DELETE CONFIRM ================= -->
        <Grid x:Name="ProfileDeleteModalOverlay" Grid.Row="1" Visibility="Collapsed" Background="#7A060812"
              MouseLeftButtonDown="ProfileDeleteBackdrop_MouseLeftButtonDown">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="430"
                  MouseLeftButtonDown="ProfileDeleteCard_MouseLeftButtonDown">
                <Border CornerRadius="16" Background="#22000000" IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.65" />
                    </Border.Effect>
                </Border>
                <Border x:Name="ProfileDeleteCard" Style="{StaticResource GlassCardStyle}" Padding="26">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="#22E5534B" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Delete24" FontSize="20" Foreground="#E5534B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtProfileDeleteTitle" Text="Profili Sil" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock x:Name="TxtProfileDeleteWarning" Text="Bu işlem geri alınamaz" Style="{StaticResource Caption}" Foreground="#E5534B" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                            <ui:Button Appearance="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Padding="6" Click="BtnCancelProfileDelete_Click" ToolTip="Kapat">
                                <ui:SymbolIcon Symbol="Dismiss20" FontSize="15" />
                            </ui:Button>
                        </Grid>

                        <TextBlock x:Name="TxtProfileDeletePrompt" Text="Bu profili silmek istediğinize emin misiniz?" TextWrapping="Wrap" Margin="0,0,0,22" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button x:Name="BtnProfileDeleteCancel" Content="Vazgeç" Click="BtnCancelProfileDelete_Click" Padding="18,9" CornerRadius="10" Margin="0,0,10,0" />
                            <ui:Button x:Name="BtnProfileDeleteConfirm" Appearance="Danger" Content="Profili Sil" Padding="20,9" CornerRadius="10" Click="BtnConfirmProfileDelete_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
