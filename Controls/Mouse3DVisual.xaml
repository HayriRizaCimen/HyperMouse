<UserControl x:Class="HyperMouse.Controls.Mouse3DVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="360" d:DesignWidth="480"
             Background="Transparent">

    <Grid ClipToBounds="True">
        <!-- Ambient studio backdrop glow behind mouse -->
        <Ellipse Width="280" Height="220" Opacity="0.16" IsHitTestVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#3B8EEA" Offset="0" />
                    <GradientStop Color="#003B8EEA" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- True 3D Interactive Viewport -->
        <Viewport3D x:Name="Viewport"
                    MouseLeftButtonDown="Viewport_MouseLeftButtonDown"
                    MouseMove="Viewport_MouseMove"
                    MouseLeftButtonUp="Viewport_MouseLeftButtonUp"
                    MouseLeave="Viewport_MouseLeave"
                    Cursor="Hand">
            <Viewport3D.Camera>
                <PerspectiveCamera x:Name="Camera"
                                   Position="-4.4,5.2,4.9"
                                   LookDirection="4.4,-4.8,-4.9"
                                   UpDirection="0,1,0"
                                   FieldOfView="33" />
            </Viewport3D.Camera>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <Model3DGroup x:Name="SceneRoot">
                        <!-- 4-Point Studio Lighting Rig -->
                        <AmbientLight Color="#282E38" />
                        <DirectionalLight Color="#FFF8EE" Direction="0.40,-0.84,0.36" />
                        <DirectionalLight Color="#5AB2FA" Direction="-0.72,-0.30,-0.62" />
                        <DirectionalLight Color="#DCE6F2" Direction="0.88,-0.22,-0.38" />
                        <DirectionalLight Color="#202630" Direction="0.0,0.88,0.18" />
                    </Model3DGroup>
                </ModelVisual3D.Content>
            </ModelVisual3D>
        </Viewport3D>

        <!-- Top-left camera presets -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,2,0,0"
                CornerRadius="8" Padding="3"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="BtnViewDefault" Content="3/4" FontSize="11" Padding="8,3"
                           Appearance="Transparent" Click="BtnViewDefault_Click" ToolTip="Varsayılan 3D açı" />
                <ui:Button x:Name="BtnViewSide" Content="Yan" FontSize="11" Padding="8,3"
                           Appearance="Transparent" Click="BtnViewSide_Click" ToolTip="Yan tuşlar (X1 / X2) açısı" />
                <ui:Button x:Name="BtnViewTop" Content="Üst" FontSize="11" Padding="8,3"
                           Appearance="Transparent" Click="BtnViewTop_Click" ToolTip="Üstten görünüm" />
            </StackPanel>
        </Border>

        <!-- Top-right orbit hint -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,2,0"
                CornerRadius="8" Padding="8,4" IsHitTestVisible="False"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="ArrowRotateClockwise16" FontSize="12" Margin="0,0,5,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Sürükle: 3D Döndür" FontSize="10.5"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Wheel / Hover HUD indicator pill -->
        <Border x:Name="HudBadge" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"
                CornerRadius="12" Padding="12,5" IsHitTestVisible="False"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="#663B8EEA" BorderThickness="1"
                Opacity="0">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="HudDot" Width="7" Height="7" Fill="#3B8EEA" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock x:Name="HudText" Text="" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
